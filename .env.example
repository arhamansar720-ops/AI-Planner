# Supabase project (Settings → API). The publishable/anon key is safe for the browser;
# row-level security restricts every row to its owner.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: any WebLLM prebuilt model id. Defaults to Qwen3-8B-q4f16_1-MLC.
# NEXT_PUBLIC_LOCAL_MODEL=Qwen3-4B-q4f16_1-MLC

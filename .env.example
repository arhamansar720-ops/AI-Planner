# Postgres connection string. On Render this is filled in automatically from
# the database (see render.yaml). The schema is applied on every start.
DATABASE_URL=postgres://user:password@localhost:5432/forma
# Set to "true" to force TLS (e.g. Render's *external* URL), "false" to turn it off.
# DATABASE_SSL=

# The site's public address, used for Google/Microsoft redirects and email links.
# On Render, RENDER_EXTERNAL_URL is used automatically if this is empty.
APP_URL=http://localhost:3000

# Optional: Google sign-in (Google Cloud Console → Credentials → OAuth client, Web).
# Authorized redirect URI: <APP_URL>/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: Microsoft sign-in (Azure portal → Microsoft Entra ID → App registrations).
# Redirect URI (Web): <APP_URL>/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" allows personal and work/school accounts.
MICROSOFT_TENANT_ID=common

# Optional: password-reset emails through Resend (resend.com, free tier).
# Without these, "Forgot password?" is hidden.
RESEND_API_KEY=
EMAIL_FROM="Forma <noreply@yourdomain.com>"

# Optional: any WebLLM prebuilt model id. Defaults to Qwen3-8B-q4f16_1-MLC.
# NEXT_PUBLIC_LOCAL_MODEL=Qwen3-4B-q4f16_1-MLC

# Optional: a shared test account. Sign in with username "admin" and this
# password (at least 8 characters). Remove it to switch the account off.
# DEMO_ADMIN_PASSWORD=
